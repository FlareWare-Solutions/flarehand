{
  "description": "flarehand: a session-start nudge to use the skill, a compaction checkpoint kept in the system temp folder, and the house-voice reminder. Every hook exits 0 and none writes inside the plugin.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" prompt-submit || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" stop || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" pre-compact || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-end || true",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
